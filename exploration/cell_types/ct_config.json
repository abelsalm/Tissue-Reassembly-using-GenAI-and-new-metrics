{
  "seed": 0,
  "device": "cuda",
  "output_dir": "exploration/cell_types/outputs",
  "log_dir": "exploration/cell_types/logs",
  "run_name": "ct_transformer_gate_best",
  "wandb": {
    "enabled": true,
    "project": "cell_types",
    "entity": null,
    "mode": "online",
    "tags": [
      "gate_best",
      "bag2_joint"
    ],
    "log_every_steps": false,
    "log_per_class_acc": false
  },
  "soft_cme": {
    "enabled": true,
    "auto_precompute": true,
    "sigma": 96.0,
    "exclude_self": true,
    "cutoff_radius": null,
    "out_dir": "exploration/cell_types/outputs/ct_soft_cmes",
    "aux_sigmas": [
      50.0,
      64.0
    ]
  },
  "dataset": {
    "dataset_name": "MERFISH_small_cortex",
    "gene_columns_start": 0,
    "gene_columns_end": 254,
    "train_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_train.csv",
    "validation_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "test_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "maximum_graph_size": {
      "train": 8192,
      "validation": 8192,
      "test": 8192
    },
    "num_workers": 0,
    "pin_memory": true,
    "subsample_n": null,
    "subsample_per_section": false
  },
  "model": {
    "n_layers": 4,
    "predict_cme": true,
    "feature_cross": true,
    "feature_cross_include_h": true,
    "cme_presence_gate": true,
    "dropout_cls": 0.3,
    "dropout_cme": 0.0,
    "dropout_fusion": 0.0,
    "dropout_layer": 0.15,
    "gene_mlp_activation": "silu",
    "cls_activation": "silu",
    "cme_activation": "silu",
    "fusion_activation": "silu",
    "layer_activation": "silu",
    "gene_mlp_depth": 3,
    "global_skip": "concat",
    "subgraph_summary": true,
    "hidden_mlp_dims": {
      "gene": 64,
      "cls": 96,
      "cme": 320,
      "presence": 128,
      "type_stage1": 96,
      "env_stage1": 320,
      "fusion": 384
    },
    "hidden_dims": {
      "dx": 96,
      "num_heads": 8,
      "dim_ffX": 192
    }
  },
  "loss": {
    "name": "combined",
    "label_smoothing": 0.06,
    "cls_weight": 1.0,
    "cme_weight": 2.0,
    "cme_softce_source": "gated_joint",
    "cme_gated_weight": 0.0,
    "presence_weight": 0.0,
    "presence_target": "mass",
    "presence_pos_weight": "auto",
    "presence_saturation": 1.0,
    "stage1_cls_weight": 0.0,
    "stage1_cme_weight": 0.0,
    "aux_cme_weight": 0.17,
    "cme_spearman_weight": 0,
    "cme_spearman_tau": 0.01,
    "cme_spearman_chunk_size": 64,
    "bag_cme_weight": 2.0
  },
  "train": {
    "n_epochs": 1000,
    "batch_size": 2,
    "lr": 0.00018,
    "weight_decay": 0.0005,
    "grad_clip": 1.0,
    "log_every": 20,
    "val_every_n_epochs": 2,
    "save_every_n_epochs": 20,
    "rechunk_every_n_epochs": 1,
    "scheduler": {
      "name": "none"
    },
    "early_stopping": {
      "enabled": true,
      "monitor": "val/eval_loss",
      "patience": 45,
      "min_delta": 0.0003
    },
    "ema": {
      "enabled": true,
      "decay": 0.98
    }
  },
  "validation": {
    "batch_size": 2
  },
  "test": {
    "batch_size": 2
  }
}
