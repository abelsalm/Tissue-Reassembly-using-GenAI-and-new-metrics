{
  "seed": 0,
  "device": "cuda",
  "output_dir": "exploration/cell_types/outputs",
  "run_name": "ct_transformer",

  "wandb": {
    "enabled": true,
    "project": "cell_types",
    "entity": null,
    "mode": "online",
    "tags": ["ct_transformer", "merfish", "cme_head"],
    "log_every_steps": true,
    "log_per_class_acc": true
  },

  "soft_cme": {
    "enabled": true,
    "auto_precompute": true,
    "sigma": 96.0,
    "exclude_self": true,
    "cutoff_radius": null,
    "out_dir": "exploration/cell_types/outputs/ct_soft_cmes"
  },

  "dataset": {
    "dataset_name": "MERFISH_small_cortex",
    "gene_columns_start": 0,
    "gene_columns_end": 254,
    "train_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_train.csv",
    "validation_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "test_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "maximum_graph_size": {
      "train": 2048,
      "validation": 2048,
      "test": 2048
    },
    "num_workers": 0,
    "pin_memory": true,
    "subsample_n": null,
    "subsample_per_section": false
  },

  "model": {
    "n_layers": 2,
    "predict_cme": true,
    "feature_cross": true,
    "feature_cross_include_h": true,
    "dropout_cls": 0.3,
    "dropout_cme": 0.1,
    "dropout_fusion": 0.1,
    "dropout_layer": 0.25,
    "gene_mlp_activation": "silu",
    "cls_activation": "silu",
    "cme_activation": "silu",
    "fusion_activation": "silu",
    "global_skip": "concat",
    "subgraph_summary": false,
    "hidden_mlp_dims": {
      "gene": 32,
      "cls": 32,
      "cme": 128,
      "type_stage1": 32,
      "env_stage1": 128,
      "fusion": 64
    },
    "hidden_dims": {
      "dx": 64,
      "num_heads": 8,
      "dim_ffX": 64
    }
  },

  "loss": {
    "name": "combined",
    "label_smoothing": 0.05,
    "cls_weight": 1.0,
    "cme_weight": 1.0,
    "stage1_cls_weight": 0.5,
    "stage1_cme_weight": 0.5
  },

  "train": {
    "n_epochs": 1000,
    "batch_size": 8,
    "lr": 0.0002,
    "weight_decay": 0.001,
    "grad_clip": 1.0,
    "log_every": 20,
    "val_every_n_epochs": 2,
    "save_every_n_epochs": 20,
    "rechunk_every_n_epochs": 1,
    "early_stopping": {
      "enabled": true,
      "monitor": "val/loss",
      "patience": 16,
      "min_delta": 0.001
    }
  },

  "validation": {
    "batch_size": 8
  },

  "test": {
    "batch_size": 8
  }
}
