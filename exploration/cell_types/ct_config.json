{
  "seed": 0,
  "device": "cuda",
  "output_dir": "exploration/cell_types/outputs",
  "run_name": "ct_transformer",

  "dataset": {
    "dataset_name": "MERFISH_small_cortex",
    "gene_columns_start": 0,
    "gene_columns_end": 254,
    "train_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_train.csv",
    "validation_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "test_data_path": "/home/abel/biodata/MERFISH_LUNA_small_cortex/MERFISH_mouse_cortex_test.csv",
    "maximum_graph_size": {
      "train": 512,
      "validation": 512,
      "test": 512
    },
    "num_workers": 0,
    "pin_memory": true,
    "subsample_n": null,
    "subsample_per_section": false
  },

  "model": {
    "n_layers": 4,
    "dropout_cls": 0.1,
    "dropout_layer": 0.1,
    "gene_mlp_activation": "relu",
    "global_skip": null,
    "subgraph_summary": false,
    "hidden_mlp_dims": {
      "X": 384
    },
    "hidden_dims": {
      "dx": 64,
      "num_heads": 16,
      "dim_ffX": 384
    }
  },

  "loss": {
    "name": "cross_entropy"
  },

  "train": {
    "n_epochs": 50,
    "batch_size": 4,
    "lr": 0.0005,
    "weight_decay": 0.0001,
    "grad_clip": 1.0,
    "log_every": 20,
    "val_every_n_epochs": 1,
    "save_every_n_epochs": 10
  },

  "validation": {
    "batch_size": 4
  },

  "test": {
    "batch_size": 4
  }
}
